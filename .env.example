GEMINI_API_KEY=
# Model IDs change fairly often — check https://ai.google.dev/gemini-api/docs/models
# before relying on these defaults. gemini-embedding-001 is deprecated; gemini-embedding-2
# is the current multimodal embedding model as of writing.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# Leave CHROMA_HOST empty for local dev (M1/M2) -- falls back to a local
# PersistentClient. docker-compose.yml sets CHROMA_HOST=chroma directly for M3+,
# no need to set it here.
CHROMA_HOST=
CHROMA_PORT=8000
COLLECTION_NAME=rulebooks
